# ── Ollama Cloud (optional) ───────────────────────────────────────────────────
# Set OLLAMA_API_KEY to route LLM calls to Ollama Cloud.
# Leave blank to use a local Ollama instance at http://localhost:11434.
OLLAMA_API_KEY=

# Ollama Cloud base URL (default shown — only change if self-hosting)
OLLAMA_BASE_URL=https://ollama.com/v1

# LLM model for entity extraction and persona synthesis.
# Cloud default : ministral-3:8b   (fast, no thinking tokens)
# Local default : qwen3:4b
OLLAMA_MODEL=ministral-3:8b

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Service tuning ────────────────────────────────────────────────────────────
# Number of background workers processing the ingest queue concurrently.
INGEST_CONCURRENCY=4

# Port the FastAPI server listens on.
PORT=8000
