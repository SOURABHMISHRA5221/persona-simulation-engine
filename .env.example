# ── Simulation Engine ─────────────────────────────────────────────────────────

# LLM backend for agent decisions
OLLAMA_API_KEY=          # Ollama Cloud key (leave blank to use local Ollama)
GEMINI_API_KEY=          # Google Gemini key

# Graphiti KG service URL — set this to pull live personas instead of static JSON
GRAPHITI_URL=http://localhost:8000

# ── graphiti_service ──────────────────────────────────────────────────────────
# (used when running graphiti_service/main.py)

# Same Ollama Cloud key used for LLM entity extraction in the KG service
# OLLAMA_API_KEY is shared between both services

# Neo4j (started via graphiti_service/docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Number of background workers processing the ingest queue
INGEST_CONCURRENCY=4
